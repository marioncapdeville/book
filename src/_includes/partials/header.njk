<header class="site-header">
  <a class="site-header__identity" href="{{ '/en/' if lang == 'en' else '/' }}">
    <svg class="site-header__star" viewBox="0 0 23.34 23.48" fill="none" aria-hidden="true">
      <g stroke="currentColor" stroke-miterlimit="10">
        <line x1="11.67" y1=".71" x2="11.67" y2="22.92"/>
        <line x1=".57" y1="11.81" x2="22.78" y2="11.81"/>
        <line x1="3.82" y1="3.96" x2="19.52" y2="19.66"/>
        <line x1="3.82" y1="19.66" x2="19.52" y2="3.96"/>
        <line x1="1.4" y1="16.03" x2="21.94" y2="7.59"/>
        <line x1="15.89" y1="22.09" x2="7.45" y2="1.54"/>
        <line x1="7.39" y1="22.06" x2="15.95" y2="1.56"/>
        <line x1="21.92" y1="16.09" x2="1.42" y2="7.53"/>
      </g>
    </svg>
    <span class="site-header__stack">
      <span class="site-header__name">{{ site.name }}</span>
    </span>
  </a>

  <button class="site-header__toggle" type="button" aria-label="{{ L.menuOpen }}" aria-expanded="false" aria-controls="site-nav">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="site-header__nav" id="site-nav">
    <ul>
      {% for item in site.nav %}
      {% set itemUrl = (item.url_en if lang == "en" else item.url) %}
      <li><a href="{{ itemUrl }}" {% if itemUrl == page.url %}aria-current="page"{% endif %}>{{ item.label_en if lang == "en" else item.label }}</a></li>
      {% endfor %}
      <li class="site-header__lang">
        {% set switchUrl = altUrl or ('/' if lang == 'en' else '/en/') %}
        {% if lang == "en" %}
        <a href="{{ switchUrl }}" hreflang="fr" lang="fr" title="{{ L.switchLabel }}">FR</a><span aria-hidden="true">/</span><span class="is-current" aria-current="true">EN</span>
        {% else %}
        <span class="is-current" aria-current="true">FR</span><span aria-hidden="true">/</span><a href="{{ switchUrl }}" hreflang="en" lang="en" title="{{ L.switchLabel }}">EN</a>
        {% endif %}
      </li>
    </ul>
  </nav>
</header>

<script>
  (function () {
    var header = document.querySelector(".site-header");
    var toggle = header.querySelector(".site-header__toggle");
    toggle.addEventListener("click", function () {
      var isOpen = header.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      toggle.setAttribute("aria-label", isOpen ? {{ L.menuClose | dump | safe }} : {{ L.menuOpen | dump | safe }});
    });
  })();
</script>
