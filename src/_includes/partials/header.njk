<header class="site-header">
  <a class="site-header__identity" href="/">
    <span class="site-header__name">
      <svg class="site-header__star" viewBox="0 0 100 100" fill="none" aria-hidden="true">
        <path d="M 49.71 46.01 L 50.00 2.00 L 50.29 46.01 Z M 51.26 46.20 L 68.37 5.65 L 51.80 46.43 Z M 52.61 46.97 L 83.94 16.06 L 53.03 47.39 Z M 53.57 48.20 L 94.35 31.63 L 53.80 48.74 Z M 53.99 49.71 L 98.00 50.00 L 53.99 50.29 Z M 53.80 51.26 L 94.35 68.37 L 53.57 51.80 Z M 53.03 52.61 L 83.94 83.94 L 52.61 53.03 Z M 51.80 53.57 L 68.37 94.35 L 51.26 53.80 Z M 50.29 53.99 L 50.00 98.00 L 49.71 53.99 Z M 48.74 53.80 L 31.63 94.35 L 48.20 53.57 Z M 47.39 53.03 L 16.06 83.94 L 46.97 52.61 Z M 46.43 51.80 L 5.65 68.37 L 46.20 51.26 Z M 46.01 50.29 L 2.00 50.00 L 46.01 49.71 Z M 46.20 48.74 L 5.65 31.63 L 46.43 48.20 Z M 46.97 47.39 L 16.06 16.06 L 47.39 46.97 Z M 48.20 46.43 L 31.63 5.65 L 48.74 46.20 Z" fill="currentColor"/>
      </svg>
      {{ site.name }}
    </span>
    <span class="site-header__role">{{ site.role }}</span>
  </a>
  <nav class="site-header__nav">
    <ul>
      {% for item in site.nav %}
      <li><a href="{{ item.url }}" {% if item.url == page.url %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>
