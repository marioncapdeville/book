<article class="project">
  {% set services = pd | tr("services", lang) %}
  {% set pTitle = pd | tr("title", lang) %}
  {% if services and services.length %}
  <header class="project__head">
    <div class="project__aside">
      <h1 class="project__name">{{ (pd | tr("shortTitle", lang)) or (pTitle | shortName) }}</h1>
      {% set nameSubtitle = pd | tr("nameSubtitle", lang) %}{% if nameSubtitle %}<span class="project__subtitle">{{ nameSubtitle }}</span>{% endif %}
      <span class="project__dash" aria-hidden="true">-</span>
      <p class="project__services">
        {% for service in services %}<span>{{ service }}</span>{% endfor %}
      </p>
      {% if pd.externalLink and pd.externalLink.url %}
      <a class="project__link" href="{{ pd.externalLink.url }}" target="_blank" rel="noopener">{{ (pd.en.linkLabel if (lang == "en" and pd.en and pd.en.linkLabel) else pd.externalLink.label) or L.seeOnline }}</a>
      {% endif %}
    </div>
    {% if bodyHtml %}<div class="project__text">{{ bodyHtml | sectionize | safe }}</div>{% endif %}
  </header>
  {% else %}
  <header class="project__intro">
    <p class="project__category">{{ pd.category | categoryLabel(site.categories, lang) }}</p>
    <h1 class="project__title">{{ pTitle }}</h1>
    {% if pd.excerpt %}<p class="project__excerpt">{{ pd.excerpt }}</p>{% endif %}
    {% if bodyHtml %}<div class="project__description">{{ bodyHtml | safe }}</div>{% endif %}
    {% if pd.externalLink and pd.externalLink.url %}
    <a class="project__link" href="{{ pd.externalLink.url }}" target="_blank" rel="noopener">{{ pd.externalLink.label or L.seeOnline }}</a>
    {% endif %}
    {% if pd.tags and pd.tags.length %}
    <ul class="project__tags">
      {% for tag in pd.tags %}<li>{{ tag }}</li>{% endfor %}
    </ul>
    {% endif %}
  </header>
  {% endif %}

  {% set galleryCols = (pd.galleryColumns | int) or 3 %}
  <div class="project__gallery project__gallery--{{ galleryCols }}" data-columns="{{ galleryCols }}">
    {% for item in pd.gallery %}
    <figure class="project__gallery-item">
      <div class="project__gallery-media">
        {% image item.image, item.alt or pTitle %}
      </div>
    </figure>
    {% endfor %}
  </div>
</article>

<script>
  // Galerie : lecture de gauche à droite, chaque image va dans la colonne la plus courte
  (function () {
    var gallery = document.querySelector(".project__gallery");
    if (!gallery) return;
    var items = Array.prototype.slice.call(gallery.querySelectorAll(".project__gallery-item"));
    var current = 0;
    function ratio(item) {
      var el = item.querySelector("img, video");
      var w = el && (el.getAttribute("width") || el.videoWidth);
      var h = el && (el.getAttribute("height") || el.videoHeight);
      return w && h ? h / w : 1;
    }
    function layout() {
      var w = window.innerWidth;
      var max = parseInt(gallery.getAttribute("data-columns"), 10) || 3;
      var n = w > 900 ? max : (w > 520 ? Math.min(2, max) : 1);
      if (n === current) return;
      current = n;
      gallery.innerHTML = "";
      gallery.classList.add("is-arranged");
      var cols = [], heights = [];
      for (var c = 0; c < n; c++) {
        var col = document.createElement("div");
        col.className = "project__gallery-col";
        gallery.appendChild(col);
        cols.push(col);
        heights.push(0);
      }
      items.forEach(function (item) {
        var i = heights.indexOf(Math.min.apply(null, heights));
        cols[i].appendChild(item);
        heights[i] += ratio(item) + 0.05;
      });
    }
    layout();
    window.addEventListener("resize", layout);
    // Les vidéos ne connaissent leur format qu'une fois chargées : on réajuste alors
    gallery.querySelectorAll("video").forEach(function (v) {
      v.addEventListener("loadedmetadata", function () { current = 0; layout(); }, { once: true });
    });

    // Visionneuse : clic sur une image pour l'ouvrir en grand, flèches et clavier pour défiler
    var box = document.createElement("div");
    box.className = "lightbox";
    box.setAttribute("role", "dialog");
    box.setAttribute("aria-modal", "true");
    box.setAttribute("aria-label", "{{ 'Image viewer' if lang == 'en' else 'Visionneuse' }}");
    box.hidden = true;
    box.innerHTML =
      '<div class="lightbox__stage"></div>' +
      '<button type="button" class="lightbox__close" aria-label="{{ 'Close' if lang == 'en' else 'Fermer' }}">&times;</button>' +
      '<button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="{{ 'Previous' if lang == 'en' else 'Précédente' }}"><span></span></button>' +
      '<button type="button" class="lightbox__nav lightbox__nav--next" aria-label="{{ 'Next' if lang == 'en' else 'Suivante' }}"><span></span></button>' +
      '<p class="lightbox__count" aria-live="polite"></p>';
    document.body.appendChild(box);
    var stage = box.querySelector(".lightbox__stage");
    var count = box.querySelector(".lightbox__count");
    var index = 0, lastFocus = null;

    function largest(item) {
      var source = item.querySelector('source[type="image/webp"]') || item.querySelector("img[srcset]");
      if (source) {
        var list = source.getAttribute("srcset").split(",");
        return list[list.length - 1].trim().split(" ")[0];
      }
      var img = item.querySelector("img");
      return img ? img.getAttribute("src") : "";
    }
    function show(i) {
      index = (i + items.length) % items.length;
      var item = items[index];
      stage.innerHTML = "";
      var video = item.querySelector("video");
      if (video) {
        var v = document.createElement("video");
        v.src = video.getAttribute("src");
        v.controls = true;
        v.playsInline = true;
        v.autoplay = true;
        v.setAttribute("aria-label", video.getAttribute("aria-label") || "");
        stage.appendChild(v);
      } else {
        var img = item.querySelector("img");
        var big = document.createElement("img");
        big.src = largest(item);
        big.alt = img ? img.alt : "";
        stage.appendChild(big);
      }
      count.textContent = (index + 1) + " / " + items.length;
    }
    function open(i) {
      lastFocus = document.activeElement;
      box.hidden = false;
      document.documentElement.classList.add("has-lightbox");
      show(i);
      box.querySelector(".lightbox__close").focus();
    }
    function close() {
      box.hidden = true;
      stage.innerHTML = "";
      document.documentElement.classList.remove("has-lightbox");
      if (lastFocus) lastFocus.focus();
    }
    if (items.length < 2) box.classList.add("lightbox--single");

    items.forEach(function (item, i) {
      var media = item.querySelector(".project__gallery-media");
      media.setAttribute("tabindex", "0");
      media.setAttribute("role", "button");
      media.setAttribute("aria-label", "{{ 'Enlarge' if lang == 'en' else 'Agrandir' }}");
      media.addEventListener("click", function () { open(i); });
      media.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(i); }
      });
    });
    box.querySelector(".lightbox__close").addEventListener("click", close);
    box.querySelector(".lightbox__nav--prev").addEventListener("click", function () { show(index - 1); });
    box.querySelector(".lightbox__nav--next").addEventListener("click", function () { show(index + 1); });
    box.addEventListener("click", function (e) { if (e.target === box || e.target === stage) close(); });
    document.addEventListener("keydown", function (e) {
      if (box.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowRight") show(index + 1);
      else if (e.key === "ArrowLeft") show(index - 1);
      else if (e.key === "Tab") {
        // Garde le focus dans la visionneuse
        var f = box.querySelectorAll("button, video");
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    // Glisser du doigt sur mobile
    var x0 = null;
    box.addEventListener("touchstart", function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    box.addEventListener("touchend", function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  })();
</script>

{% set related = collections.projects | relatedProjects(pd.slug, pd.category, 4) %}
{% if related.length %}
<aside class="related">
  <h2>{{ L.related }}</h2>
  <div class="related__grid">
    {% for project in related %}
      <a class="related__item" href="{{ project | projectUrl(lang) }}">
        <div class="related__item-media">
          {% image project.data.cover, project.data.coverAlt or (project.data | tr("title", lang)), "200px" %}
        </div>
        <div class="related__item-veil">
          <span class="related__item-title">{{ project.data | tr("title", lang) }}</span>
          <span class="related__item-category">{{ project.data.category | categoryLabel(site.categories, lang) }}</span>
        </div>
      </a>
    {% endfor %}
  </div>
</aside>
{% endif %}
