{% set entries = projects | homepageEntries %}
{% if entries.length %}
<div class="project-grid">
  {% for entry in entries %}
  {% set coverColor = dominantColors[entry.cover] or "#e5e0d8" %}
  {% set ratio = entry.project.data.cardFormat | cardFormat(entry.key) %}
  <a class="project-card" href="{{ entry.project.url }}" style="--card-color: {{ coverColor }}; --card-ratio: {{ ratio }};">
    <div class="project-card__media">
      {% image entry.cover, entry.project.data.title %}
    </div>
    <div class="project-card__veil">
      <span class="project-card__title">{{ entry.project.data.title }}</span>
      <span class="project-card__category">{{ entry.project.data.category | categoryLabel(site.categories) }}</span>
    </div>
  </a>
  {% endfor %}
</div>
{% else %}
<p class="empty-state">{{ emptyMessage or "Aucun projet publié pour l'instant." }}</p>
{% endif %}
