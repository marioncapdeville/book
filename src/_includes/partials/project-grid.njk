{% set entries = projects | homepageEntries %}
{% if entries.length %}
<div class="project-grid">
  {% for entry in entries %}
  {% set coverColor = dominantColors[entry.cover] or "#e5e0d8" %}
  {% set ratio = entry.project.data.cardFormat | cardFormat(entry.key) %}
  <a class="project-card" href="{{ entry.project | projectUrl(lang) }}" style="--card-color: {{ coverColor }}; --card-ratio: {{ ratio }};">
    <div class="project-card__media">
      {% image entry.cover, entry.project.data.coverAlt or (entry.project.data | tr("title", lang)) %}
    </div>
    <div class="project-card__veil">
      <span class="project-card__title">{{ entry.project.data | tr("title", lang) }}</span>
      <span class="project-card__category">{{ entry.project.data.category | categoryLabel(site.categories, lang) }}</span>
    </div>
  </a>
  {% endfor %}
</div>
<script>
  // Vignettes : lecture de gauche à droite, ligne par ligne (ordre réglé dans /reorder)
  (function () {
    var grids = document.querySelectorAll(".project-grid:not([data-arranged])");
    Array.prototype.forEach.call(grids, function (grid) {
      grid.setAttribute("data-arranged", "");
      var cards = Array.prototype.slice.call(grid.querySelectorAll(".project-card"));
      var current = 0;
      function layout() {
        var n = window.innerWidth > 900 ? 3 : 2;
        if (n === current) return;
        current = n;
        grid.innerHTML = "";
        grid.classList.add("is-arranged");
        var cols = [];
        for (var c = 0; c < n; c++) {
          var col = document.createElement("div");
          col.className = "project-grid__col";
          grid.appendChild(col);
          cols.push(col);
        }
        // Ligne par ligne : 1re vignette à gauche, 2e au milieu, 3e à droite, puis on recommence
        cards.forEach(function (card, k) {
          cols[k % n].appendChild(card);
        });
      }
      layout();
      window.addEventListener("resize", layout);
    });
  })();
</script>
{% else %}
<p class="empty-state">{{ emptyMessage or L.empty }}</p>
{% endif %}
