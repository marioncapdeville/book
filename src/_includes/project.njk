---
layout: base.njk
---
<article class="project">
  {% if services and services.length %}
  <header class="project__head">
    <div class="project__aside">
      <h1 class="project__name">{{ shortTitle or (title | shortName) }}</h1>
      <span class="project__dash" aria-hidden="true">-</span>
      <p class="project__services">
        {% for service in services %}<span>{{ service }}</span>{% endfor %}
      </p>
      {% if externalLink and externalLink.url %}
      <a class="project__link" href="{{ externalLink.url }}" target="_blank" rel="noopener">{{ externalLink.label or "Voir en ligne" }}</a>
      {% endif %}
    </div>
    {% if content %}<div class="project__text">{{ content | sectionize | safe }}</div>{% endif %}
  </header>
  {% else %}
  <header class="project__intro">
    <p class="project__category">{{ category | categoryLabel(site.categories) }}</p>
    <h1 class="project__title">{{ title }}</h1>
    {% if excerpt %}<p class="project__excerpt">{{ excerpt }}</p>{% endif %}
    {% if content %}<div class="project__description">{{ content | safe }}</div>{% endif %}
    {% if externalLink and externalLink.url %}
    <a class="project__link" href="{{ externalLink.url }}" target="_blank" rel="noopener">{{ externalLink.label or "Voir en ligne" }}</a>
    {% endif %}
    {% if tags and tags.length %}
    <ul class="project__tags">
      {% for tag in tags %}<li>{{ tag }}</li>{% endfor %}
    </ul>
    {% endif %}
  </header>
  {% endif %}

  <div class="project__gallery">
    {% for item in gallery %}
    <figure class="project__gallery-item">
      <div class="project__gallery-media">
        {% image item.image, item.alt or title %}
      </div>
    </figure>
    {% endfor %}
  </div>
</article>

{% set related = collections.projects | relatedProjects(slug, category, 4) %}
{% if related.length %}
<aside class="related">
  <h2>Projets similaires</h2>
  <div class="related__grid">
    {% for project in related %}
      <a class="related__item" href="{{ project.url }}">
        <div class="related__item-media">
          {% image project.data.cover, project.data.coverAlt or project.data.title, "200px" %}
        </div>
        <div class="related__item-veil">
          <span class="related__item-title">{{ project.data.title }}</span>
          <span class="related__item-category">{{ project.data.category | categoryLabel(site.categories) }}</span>
        </div>
      </a>
    {% endfor %}
  </div>
</aside>
{% endif %}
